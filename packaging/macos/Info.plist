<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Sketch</string>
	<key>CFBundleDisplayName</key>
	<string>Sketch</string>
	<key>CFBundleIdentifier</key>
	<string>com.heyfabrika.sketch</string>
	<key>CFBundleExecutable</key>
	<string>sketch-rs</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both match the version in Cargo.toml; Sparkle compares CFBundleVersion with the feed's. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Michael Shimeles</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Sparkle, embedded by scripts/release-macos.sh, checks this feed once a day and installs
	     only updates signed with the private half of this key, which `generate_keys --account sketch`
	     keeps in the release Mac's login keychain. Every release must be signed with the same key. -->
	<key>SUFeedURL</key>
	<string>https://github.com/michaelshimeles/sketch/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>AkzxheHG06pVZ4qO48rPUI6iin0my51aiWmnE0nYGPM=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
