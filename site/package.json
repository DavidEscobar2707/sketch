{
	"name": "sketch-rs-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"shots": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/sketch-rs-site-shots}\" cargo run --release --manifest-path scripts/screenshots/Cargo.toml -- scripts/screenshots/out",
		"images": "node scripts/build-images.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"roughjs": "^4.6.6",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"description": "Download page for Sketch, a native canvas for designing and sketching on the Mac",
	"engines": {
		"node": ">=22.17"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	}
}
